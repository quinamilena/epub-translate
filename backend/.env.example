# Configurações da API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Provedor de tradução
TRANSLATION_PROVIDER=ollama  # openai | gemini | ollama
TRANSLATION_MODEL=translategemma:4b
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=http://ollama:11434  # ollama local (sem Docker): http://localhost:11434

# Ollama: contexto, limite de geração e penalidade de repetição
TRANSLATION_NUM_CTX=8192
TRANSLATION_NUM_PREDICT=2048
TRANSLATION_REPEAT_PENALTY=1.15

# Limites
MAX_UPLOAD_MB=50
CHUNK_SIZE=4000  # caracteres por lote
ENABLE_GLOSSARY=false

# Paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./tmp
